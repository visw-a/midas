# Copy this file to .env and fill in real values before running the server.

# Shared password for accessing the dashboard (simple password gate, no user accounts).
SITE_PASSWORD=change-me

# Random secret used to sign session cookies. Generate with e.g. `openssl rand -hex 32`.
SECRET_KEY=change-me-too

# SQLite file used to persist portfolio data (snapshots, holdings, income, price cache).
DATABASE_URL=sqlite:///./midas.db

# How often (minutes) the background job refreshes live market quotes.
PRICE_REFRESH_MINUTES=15

# Comma-separated list of origins allowed to call the API (the frontend dev server / deployed URL).
CORS_ORIGINS=http://localhost:5173

# Ticker used as the performance benchmark (any symbol Stooq supports, e.g. spy.us, voo.us).
BENCHMARK_TICKER=SPY

# Set to true once the site is served over HTTPS in production so the session cookie requires it.
COOKIE_SECURE=false
